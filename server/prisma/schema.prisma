generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  email        String        @unique
  name         String
  passwordHash String
  updatedAt    DateTime      @updatedAt
  auditLogs    AuditLog[]
  transactions Transaction[]
}

model Vendor {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  category     String
  country      String
  createdAt    DateTime      @default(now())
  riskLevel    RiskLevel     @default(LOW)
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id              Int               @id @default(autoincrement())
  amount          Decimal           @db.Decimal(12, 2)
  userId          Int
  vendorId        Int
  createdAt       DateTime          @default(now())
  currency        String            @default("USD")
  deviceId        String
  location        String
  status          TransactionStatus @default(PENDING)
  timestamp       DateTime          @default(now())
  transactionType String
  updatedAt       DateTime          @updatedAt
  alerts          Alert[]
  riskScore       RiskScore?
  user            User              @relation(fields: [userId], references: [id])
  vendor          Vendor            @relation(fields: [vendorId], references: [id])

  @@index([userId])
  @@index([vendorId])
  @@index([status])
  @@index([timestamp])
}

model RiskScore {
  id               Int         @id @default(autoincrement())
  score            Int
  transactionId    Int         @unique
  anomalyScore     Float?
  createdAt        DateTime    @default(now())
  fraudProbability Decimal?    @db.Decimal(5, 4)
  modelVersion     String?
  reasons          Json
  riskLevel        RiskLevel
  ruleScore        Int
  transaction      Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model Alert {
  id            Int         @id @default(autoincrement())
  message       String
  transactionId Int
  createdAt     DateTime    @default(now())
  severity      RiskLevel
  status        AlertStatus @default(OPEN)
  type          String
  updatedAt     DateTime    @updatedAt
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  userId    Int
  createdAt DateTime @default(now())
  entity    String
  entityId  String
  metadata  Json
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  ANALYST
  USER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum AlertStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}
